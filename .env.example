DATABASE_URL=postgres://mission_hub:replace-me@postgres:5432/mission_hub
PORT=3000
HOST=0.0.0.0
# Bootstrap admin Bearer for /api/v1/admin/clients (create/list/revoke). Never grant to service clients.
MISSION_HUB_ADMIN_TOKEN=replace-with-long-random-admin-token
# Optional seed/fallback: upserted into api_clients on boot (hashed). Prefer admin create for new clients.
MISSION_HUB_CLIENTS_JSON={"example-client":{"token":"replace-me","scopes":["missions:read","missions:write","runs:read","runs:write","summaries:read","summaries:write","evidence:read","evidence:write"]}}
