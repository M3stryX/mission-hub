DATABASE_URL=postgres://mission_hub:replace-me@postgres:5432/mission_hub
PORT=3000
HOST=0.0.0.0
# Deployment environment: development | staging | production. Unset means development; any other value is a
# configuration error and the process refuses to start (a misspelling must not silently become development).
# Outside development MISSION_HUB_ALLOWED_HOSTS is required and checked at boot.
MISSION_HUB_ENV=development
# Request Host allowlist: comma-separated, exact hostnames (ports ignored, no wildcards).
# Unset means the built-in default, which is loopback only (localhost,127.0.0.1) — right for local work.
# Loopback is always accepted and must NOT be listed here: the container's own health probe
# (http://127.0.0.1:$PORT/health) goes through this same guard. List only the names this
# deployment is served on, e.g.
#MISSION_HUB_ALLOWED_HOSTS=mission-hub.example.com,mission-hub.internal.lan
# Bootstrap admin Bearer for /api/v1/admin/clients (create/list/revoke). Never grant to service clients.
MISSION_HUB_ADMIN_TOKEN=replace-with-long-random-admin-token
# Staging only — the single gate for DELETE /api/v1/admin/verify-fixtures/:missionId (with the verify:admin scope).
# The deployment environment does not enable it; this flag is the only control. Never set it in production.
MISSION_HUB_ALLOW_DESTRUCTIVE_VERIFY=false
# Optional seed/fallback: upserted into api_clients on boot (hashed). Prefer admin create for new clients.
# verify:admin may be seeded for the dedicated n8n-verify client; it cannot be minted via admin clients API.
MISSION_HUB_CLIENTS_JSON={"example-client":{"token":"replace-me","scopes":["missions:read","missions:write","runs:read","runs:write","summaries:read","summaries:write","evidence:read","evidence:write"]}}
